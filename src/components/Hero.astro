---
// src/components/Hero.astro
import aboutData from "../data/about.json";
---

<section class="flex min-h-[calc(100vh-72px)] flex-col justify-center px-6 py-8 lg:px-11 lg:py-10">
  <div class="mx-auto w-full max-w-[1280px]" style="margin-top:-20px">
    <!-- Status pill -->
    <div class="status-pill mb-7 lg:mb-8">
      <span class="dot"></span>
      <span>Available for new opportunities · 2026</span>
    </div>

    <!-- Eyebrow -->
    <p class="eyebrow !mb-7 lg:!mb-8" style="font-size:15px;letter-spacing:3.2px">
      {aboutData.name} · {aboutData.title}
    </p>

    <!-- Hero h1 -->
    <h1
      class="font-serif font-bold text-text"
      style="font-size:clamp(40px, 7vw, 86px); line-height:1.05; letter-spacing:-2.5px; max-width:1180px; margin-bottom:36px;"
    >
      Build systems that are<br><span class="grad">reliable, scalable</span>, and<br>beautifully simple.
    </h1>

    <!-- Lead -->
    <p
      class="font-sans text-text-2"
      style="font-size:clamp(16px, 1.5vw, 21px); line-height:1.65; max-width:680px; margin-bottom:44px; font-weight:450;"
    >
      {aboutData.description}
    </p>

    <!-- CTA row -->
    <div class="flex flex-wrap items-center gap-4" style="margin-top:-10px">
      <a class="btn-primary" href="#work">查看作品 →</a>
      <a class="btn-ghost" href="#contact">联系我</a>
    </div>
  </div>
</section>
